  "id": 6,
  "kind": "converted_answerable",
  "question": "Is the result of a FastAPI dependency (Depends) cached, and for what scope?",
  "ask": {
   "refused": false,
   "refusal_reason": null,
   "answer": "The result of a FastAPI dependency (Depends) is cached per request [1]. For the scope, if a dependency is declared with `scope=\"function\"` it is closed after the path operation function returns but before the response is sent [4].",
