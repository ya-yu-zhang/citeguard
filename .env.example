# Optional OpenAI-compatible key. Leave empty to use the deterministic stub generator (no paid API).
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Leave empty for embedded/local Qdrant (HF Spaces / no docker).
# For docker compose use: http://qdrant:6333
QDRANT_URL=http://qdrant:6333
PORT=8000

# Optional: set true to use hybrid+rerank inside /ask (default false → hybrid)
# ASK_USE_RERANK=false

# Optional overrides
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
