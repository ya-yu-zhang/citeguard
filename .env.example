# LLM: any OpenAI-compatible endpoint. Leave LLM_MODEL empty → offline stub generator.
# Local, free (default): Ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=
# OpenRouter (next provider; needs a key — never commit it):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-7b-instruct
# LLM_API_KEY=sk-or-...
# LLM_MAX_TOKENS=400
# LLM_TIMEOUT_S=180
# OpenRouter: disable reasoning tokens
# LLM_EXTRA_BODY={"reasoning": {"enabled": false}}
# Inside docker compose, reach host Ollama via http://host.docker.internal:11434/v1

# Leave empty for embedded/local Qdrant (HF Spaces / no docker).
# For docker compose use: http://qdrant:6333
QDRANT_URL=http://qdrant:6333
PORT=8000

# Optional: set true to use hybrid+rerank inside /ask (default false → hybrid)
# ASK_USE_RERANK=false

# Optional overrides
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
